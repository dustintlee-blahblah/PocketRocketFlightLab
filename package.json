{
  "name": "pocket-rocket-flight-lab",
  "version": "1.0.349",
  "private": true,
  "description": "A flight simulator for hobby and high-power rockets that runs on a phone.",
  "author": "Dustin Lee",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node build.js",
    "format": "prettier --write \"src/**/*.{js,css}\" build.js tests/*.js tools/*.js validation/*.js",
    "format:check": "prettier --check \"src/**/*.{js,css}\" build.js tests/*.js tools/*.js validation/*.js",
    "lint": "eslint src/js build.js tests tools validation && node tools/unused-exports.js && node tools/check-module-tops.js && node tools/relink.js --check",
    "test": "node build.js && node tests/golden.js check tests/golden-snapshot.json --no-fixtures",
    "test:drag": "node build.js && node tests/drag-benchmarks.js",
    "test:record": "node build.js && node tests/golden.js record tests/golden-snapshot.json --no-fixtures",
    "test:smoke": "node build.js && node tests/smoke.js",
    "test:roundtrip": "node build.js && node tests/roundtrip.js",
    "test:coast": "node build.js && node tests/coast.js",
    "test:altimeters": "node build.js && node tests/altimeter-logs.js",
    "test:walkthrough": "node build.js && node tests/walkthrough.js",
    "cad:fin": "node build.js && node tools/fin-sections.js",
    "test:walkthrough:wide": "node build.js && node tests/walkthrough.js --width 1600 --out test-results/walkthrough-wide",
    "test:inputs": "node build.js && node tests/inputs.js",
    "test:exports": "node build.js && node tests/exports.js",
    "test:step": "node tests/step-export.js",
    "test:recovery": "node build.js && node tests/recovery.js",
    "test:descent": "node build.js && node tests/descent.js",
    "validate:arcas": "node build.js && node validation/arcas.js",
    "validate:openrocket": "node build.js && node validation/openrocket.js",
    "validate:accuracy": "node build.js && node validation/accuracy.js",
    "validate:flights": "node build.js && node validation/flights.js",
    "validate:drag-factors": "node build.js && node validation/drag-factors.js",
    "validate:logged": "node build.js && node validation/logged-flights.js",
    "validate:qu8k": "node build.js && node validation/qu8k-coast.js",
    "validate:proto": "node build.js && node validation/proto-coast.js",
    "validate:coast-trend": "node build.js && node validation/coast-trend.js"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@babel/traverse": "8.1.2",
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "replicad": "1.2.1",
    "replicad-opencascadejs": "1.2.1"
  }
}
