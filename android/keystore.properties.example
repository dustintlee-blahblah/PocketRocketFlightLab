# Copy this file to keystore.properties (same folder) and fill it in to sign release builds.
# keystore.properties and your keystore file are listed in .gitignore: never commit them.
storeFile=../../keys/your-release-key.p12
storeType=pkcs12
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
